import ClassicalLean.Probability.NoEdgeWealth
import Mathlib.Probability.Distributions.Uniform

/-!
# The score bound needs `Q` chosen before the outcome

`NoEdgeWealth.measureReal_exists_le_scorePred` bounds by `α` the chance that the win score
`scorePred p₀ Q W` reaches `1/α`, when each value `Q i` is chosen from the outcomes known before
outcome `i + 1` (`Q` adapted to the filtration). This file shows that requirement cannot be
dropped, on four fair coins (a space of 16 equally likely points).

The outcomes are `W (i + 1)` = coin `i` (`1` for heads, `0` for tails) for `i < 4`, and `W n = 0`
for `n = 0` and `n > 4`; the filtration is the one generated by `W`, so the chance of a win given
the past is `1/2` or `0`, never more than `p₀ = 1/2`. The value `Q i` peeks at the outcome it is
placed on: `Q i = 1` if `W (i + 1) = 1`, else `1/2`. Every other hypothesis of the bound holds, but
the score doubles at each head and stays put at each tail, so it reaches `4` within 4 outcomes
exactly when at least two coins show heads: chance `11/16`, above `α = 1/4`.

* `lookahead_breaks_score_bound`: on this space every hypothesis of the bound except that `Q` is
  adapted holds, `Q` is not adapted, and the chance of reaching `4` within 4 outcomes is `11/16`.
-/

open MeasureTheory ProbabilityTheory Filter Finset
open ClassicalLean.Probability.LikelihoodScore ClassicalLean.Probability.NoEdgeWealth

namespace ClassicalLean.Probability.ScoreLookahead

/-- Four coins. -/
abbrev Coins := Fin 4 → Bool

/-- Four fair coins, independent: each of the 16 points has chance `1/16`. -/
noncomputable def coinMeasure : Measure Coins :=
  Measure.pi fun _ ↦ (PMF.uniformOfFintype Bool).toMeasure

instance : IsProbabilityMeasure coinMeasure := by
  unfold coinMeasure; infer_instance

/-- `1` for heads, `0` for tails. -/
def bit (b : Bool) : ℝ := if b then 1 else 0

/-- The outcomes: outcome `i + 1` is coin `i` for `i < 4`; every other outcome is `0`. -/
noncomputable def coinOutcome (n : ℕ) (ω : Coins) : ℝ :=
  if h : 1 ≤ n ∧ n ≤ 4 then bit (ω ⟨n - 1, by omega⟩) else 0

/-- A value that peeks at the outcome it is used for: `1` before a head, `1/2` otherwise. -/
noncomputable def peekingValue (i : ℕ) (ω : Coins) : ℝ :=
  if coinOutcome (i + 1) ω = 1 then 1 else 1 / 2

lemma stronglyMeasurable_coinOutcome (n : ℕ) : StronglyMeasurable (coinOutcome n) :=
  (measurable_of_countable _).stronglyMeasurable

/-- The filtration generated by the outcomes. -/
noncomputable def coinFiltration : Filtration ℕ (inferInstance : MeasurableSpace Coins) :=
  Filtration.natural coinOutcome stronglyMeasurable_coinOutcome

/-- What coins `k < j` generate. -/
noncomputable abbrev before (j : Fin 4) : MeasurableSpace Coins :=
  ⨆ k ∈ {k : Fin 4 | k < j}, MeasurableSpace.comap (fun ω : Coins ↦ ω k) inferInstance

lemma coinFiltration_le_before {n : ℕ} (hn : n < 4) : coinFiltration n ≤ before ⟨n, hn⟩ := by
  refine iSup₂_le fun k hk ↦ Measurable.comap_le ?_
  unfold coinOutcome
  split_ifs with h
  · have hle : MeasurableSpace.comap (fun ω : Coins ↦ ω ⟨k - 1, by omega⟩) inferInstance ≤
        before ⟨n, hn⟩ :=
      le_iSup₂ (f := fun (k : Fin 4) (_ : k ∈ {k : Fin 4 | k < ⟨n, hn⟩}) ↦
        MeasurableSpace.comap (fun ω : Coins ↦ ω k) inferInstance) ⟨k - 1, by omega⟩
        (by simp only [Set.mem_ofPred_eq, Fin.mk_lt_mk]; omega)
    exact (measurable_of_countable bit).comp ((comap_measurable _).mono hle le_rfl)
  · exact measurable_const

lemma iIndepFun_coins : iIndepFun (fun (k : Fin 4) (ω : Coins) ↦ ω k) coinMeasure :=
  iIndepFun_pi (X := fun _ (b : Bool) ↦ b) fun _ ↦ measurable_id.aemeasurable

lemma indep_before (j : Fin 4) :
    Indep (MeasurableSpace.comap (fun ω : Coins ↦ ω j) inferInstance) (before j) coinMeasure := by
  have h := indep_iSup_of_disjoint (fun k ↦ (measurable_pi_apply k).comap_le) iIndepFun_coins
    (S := {j}) (T := {k : Fin 4 | k < j}) (by simp)
  rw [_root_.iSup_singleton] at h
  exact h

lemma coinOutcome_succ {n : ℕ} (hn : n < 4) :
    coinOutcome (n + 1) = fun ω ↦ bit (ω ⟨n, hn⟩) := by
  funext ω
  simp [coinOutcome, show 1 ≤ n + 1 ∧ n + 1 ≤ 4 from ⟨by omega, by omega⟩]

lemma coinOutcome_of_four_le {n : ℕ} (hn : 4 ≤ n) : coinOutcome (n + 1) = fun _ ↦ 0 := by
  funext ω
  unfold coinOutcome
  split_ifs with h
  · exact absurd h.2 (by omega)
  · rfl

lemma integral_bit_coin (j : Fin 4) : ∫ ω, bit (ω j) ∂coinMeasure = 1 / 2 := by
  have hmp := measurePreserving_eval (fun _ : Fin 4 ↦ (PMF.uniformOfFintype Bool).toMeasure) j
  rw [coinMeasure, ← integral_map hmp.measurable.aemeasurable
    (measurable_of_countable bit).aestronglyMeasurable, hmp.map_eq,
    integral_fintype .of_finite]
  simp [bit, Measure.real, PMF.uniformOfFintype_apply]

/-- The chance of a win given the past is at most `1/2`. -/
lemma condExp_coinOutcome_le (n : ℕ) :
    coinMeasure[coinOutcome (n + 1) | coinFiltration n] ≤ᵐ[coinMeasure] fun _ ↦ 1 / 2 := by
  rcases lt_or_ge n 4 with hn | hn
  · have hind : Indep (MeasurableSpace.comap (coinOutcome (n + 1)) inferInstance)
        (coinFiltration n) coinMeasure := by
      refine indep_of_indep_of_le_right (indep_of_indep_of_le_left (indep_before ⟨n, hn⟩) ?_)
        (coinFiltration_le_before hn)
      rw [coinOutcome_succ hn]
      exact ((measurable_of_countable bit).comp (comap_measurable _)).comap_le
    have h := condExp_indep_eq (stronglyMeasurable_coinOutcome (n + 1)).measurable.comap_le
      (coinFiltration.le n) (comap_measurable _).stronglyMeasurable hind
    filter_upwards [h] with ω hω
    rw [hω, coinOutcome_succ hn, integral_bit_coin]
  · rw [coinOutcome_of_four_le hn]
    rw [condExp_const (coinFiltration.le n) (0 : ℝ)]
    exact Eventually.of_forall fun _ ↦ by norm_num

lemma peekingValue_not_stronglyAdapted : ¬ StronglyAdapted coinFiltration peekingValue := by
  intro h
  have hbot : coinFiltration 0 ≤ ⊥ := by
    refine iSup₂_le fun k hk ↦ ?_
    have hk0 : k = 0 := Nat.le_zero.mp hk
    subst hk0
    have : coinOutcome 0 = fun _ ↦ 0 := by funext ω; simp [coinOutcome]
    rw [this]
    exact (measurable_const : @Measurable Coins ℝ ⊥ _ fun _ ↦ (0 : ℝ)).comap_le
  have hs := (h 0).measurable.mono hbot le_rfl (measurableSet_singleton (1 : ℝ))
  rcases MeasurableSpace.measurableSet_bot_iff.mp hs with he | he
  · have : (fun _ ↦ true : Coins) ∈ peekingValue 0 ⁻¹' {1} := by
      simp [peekingValue, coinOutcome, bit]
    rw [he] at this; exact this
  · have : (fun _ ↦ false : Coins) ∈ peekingValue 0 ⁻¹' {1} := by rw [he]; trivial
    norm_num [peekingValue, coinOutcome, bit] at this

/-- The factor at outcome `i + 1`: `2` for a head among the four coins, `1` otherwise. -/
def factorNat (i : ℕ) (ω : Coins) : ℕ :=
  if h : i < 4 then (if ω ⟨i, h⟩ then 2 else 1) else 1

lemma scorePred_eq (n : ℕ) (ω : Coins) :
    scorePred (1 / 2) peekingValue coinOutcome n ω = ((∏ i ∈ range n, factorNat i ω : ℕ) : ℝ) := by
  rw [scorePred, Nat.cast_prod]
  refine prod_congr rfl fun i _ ↦ ?_
  rcases lt_or_ge i 4 with hi | hi
  · simp only [peekingValue, factorNat, coinOutcome_succ hi, hi, ↓reduceDIte]
    rcases Bool.eq_false_or_eq_true (ω ⟨i, hi⟩) with hb | hb <;> norm_num [hb, bit, scoreFactor]
  · simp only [peekingValue, factorNat, coinOutcome_of_four_le hi,
      show ¬ i < 4 by omega, ↓reduceDIte]
    norm_num [scoreFactor]

/-- The event that the score reaches `4` within 4 outcomes, as a decidable condition. -/
def reachesFour (ω : Coins) : Prop :=
  ∃ n ∈ range 5, 4 ≤ ∏ i ∈ range n, factorNat i ω

instance : DecidablePred reachesFour := fun _ ↦ by unfold reachesFour; infer_instance

lemma card_reachesFour : (univ.filter reachesFour).card = 11 := by decide

lemma measureReal_singleton_coin (ω : Coins) : coinMeasure.real {ω} = 1 / 16 := by
  rw [Measure.real, coinMeasure, ← Set.univ_pi_singleton, Measure.pi_pi]
  simp [PMF.uniformOfFintype_apply, ENNReal.toReal_inv]
  norm_num

lemma measureReal_reach_four :
    coinMeasure.real {ω | ∃ n ≤ 4, 1 / (1 / 4) ≤ scorePred (1 / 2) peekingValue coinOutcome n ω} =
      11 / 16 := by
  have hset : {ω | ∃ n ≤ 4, 1 / (1 / 4) ≤ scorePred (1 / 2) peekingValue coinOutcome n ω} =
      ↑(univ.filter reachesFour) := by
    ext ω
    simp only [Set.mem_ofPred_eq, coe_filter, mem_univ, true_and, reachesFour, mem_range,
      scorePred_eq]
    norm_num only [one_div_one_div]
    constructor
    · rintro ⟨n, hn, h⟩; exact ⟨n, by omega, by exact_mod_cast h⟩
    · rintro ⟨n, hn, h⟩; exact ⟨n, by omega, by exact_mod_cast h⟩
  rw [hset, ← sum_measureReal_singleton]
  simp only [measureReal_singleton_coin, sum_const, card_reachesFour, nsmul_eq_mul]
  norm_num

/-- **Dropping "`Q` is chosen before the outcome" breaks the score bound.** On four fair coins,
with `W` the coin outcomes, `𝒢` the filtration they generate, `p₀ = 1/2` and `Q` the value that
peeks at the next outcome: the outcomes are adapted and in `[0, 1]`, the chance of a win given the
past is at most `1/2`, `Q` lies in `[1/2, 1]`, but `Q` is not adapted, and the chance that the score
reaches `1/α = 4` within 4 outcomes is `11/16`, above `α = 1/4`. -/
theorem lookahead_breaks_score_bound :
    StronglyAdapted coinFiltration coinOutcome ∧ (∀ n ω, 0 ≤ coinOutcome n ω) ∧
      (∀ n ω, coinOutcome n ω ≤ 1) ∧
      (∀ n, coinMeasure[coinOutcome (n + 1) | coinFiltration n] ≤ᵐ[coinMeasure]
        fun _ ↦ 1 / 2) ∧
      (∀ n ω, 1 / 2 ≤ peekingValue n ω) ∧ (∀ n ω, peekingValue n ω ≤ 1) ∧
      ¬ StronglyAdapted coinFiltration peekingValue ∧
      (1 / 4 : ℝ) < coinMeasure.real
        {ω | ∃ n ≤ 4, 1 / (1 / 4) ≤ scorePred (1 / 2) peekingValue coinOutcome n ω} := by
  refine ⟨Filtration.stronglyAdapted_natural _, fun n ω ↦ ?_, fun n ω ↦ ?_,
    condExp_coinOutcome_le, fun n ω ↦ ?_, fun n ω ↦ ?_, peekingValue_not_stronglyAdapted, ?_⟩
  · unfold coinOutcome bit; split_ifs <;> norm_num
  · unfold coinOutcome bit; split_ifs <;> norm_num
  · unfold peekingValue; split_ifs <;> norm_num
  · unfold peekingValue; split_ifs <;> norm_num
  · rw [measureReal_reach_four]; norm_num

end ClassicalLean.Probability.ScoreLookahead
