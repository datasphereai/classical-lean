@exists_symm_ginv : ∀ {n : Type u_1} [inst : Fintype n] (M : Matrix n n ℝ),
  Mᵀ = M → ∃ G, Gᵀ = G ∧ Commute M G ∧ M * G * M = M ∧ G * M * G = G
@exists_penrose : ∀ {m : Type u_1} {n : Type u_2} [inst : Fintype m] [inst_1 : Fintype n] (A : Matrix m n ℝ),
  ∃ X, A * X * A = A ∧ X * A * X = X ∧ (A * X)ᵀ = A * X ∧ (X * A)ᵀ = X * A
@penrose_unique : ∀ {m : Type u_1} {n : Type u_2} [inst : Fintype m] [inst_1 : Fintype n] {A : Matrix m n ℝ}
  {X Y : Matrix n m ℝ},
  A * X * A = A →
    X * A * X = X →
      (A * X)ᵀ = A * X → (X * A)ᵀ = X * A → A * Y * A = A → Y * A * Y = Y → (A * Y)ᵀ = A * Y → (Y * A)ᵀ = Y * A → X = Y
@pinv : {m : Type u_1} → {n : Type u_2} → [Fintype m] → [Fintype n] → [DecidableEq n] → Matrix m n ℝ → Matrix n m ℝ
@pinv_spec : ∀ {m : Type u_1} {n : Type u_2} [inst : Fintype m] [inst_1 : Fintype n] [inst_2 : DecidableEq n]
  (A : Matrix m n ℝ),
  A * pinv A * A = A ∧ pinv A * A * pinv A = pinv A ∧ (A * pinv A)ᵀ = A * pinv A ∧ (pinv A * A)ᵀ = pinv A * A
@pinv_unique : ∀ {m : Type u_1} {n : Type u_2} [inst : Fintype m] [inst_1 : Fintype n] [inst_2 : DecidableEq n]
  {A : Matrix m n ℝ} {X : Matrix n m ℝ},
  A * X * A = A → X * A * X = X → (A * X)ᵀ = A * X → (X * A)ᵀ = X * A → X = pinv A
@transpose_mulVec_sub_mulVec_pinv : ∀ {m : Type u_1} {n : Type u_2} [inst : Fintype m] [inst_1 : Fintype n]
  [inst_2 : DecidableEq n] (A : Matrix m n ℝ) (y : m → ℝ), Aᵀ *ᵥ (y - A *ᵥ pinv A *ᵥ y) = 0
@pinv_residual_dotProduct_le : ∀ {m : Type u_1} {n : Type u_2} [inst : Fintype m] [inst_1 : Fintype n]
  [inst_2 : DecidableEq n] (A : Matrix m n ℝ) (y : m → ℝ) (β : n → ℝ),
  (y - A *ᵥ pinv A *ᵥ y) ⬝ᵥ (y - A *ᵥ pinv A *ᵥ y) ≤ (y - A *ᵥ β) ⬝ᵥ (y - A *ᵥ β)
@pinv_eq_leastSquares : ∀ {m : Type u_1} {n : Type u_2} [inst : Fintype m] [inst_1 : Fintype n] [inst_2 : DecidableEq n]
  {A : Matrix m n ℝ}, IsUnit (Aᵀ * A).det → pinv A = Statistics.leastSquares A
rc=0
