@add_apply : ∀ {F : Type u_1} {α : outParam (Type u_2)} {β : outParam (Type u_3)} {inst : FunLike F α β}
  {inst_1 : Add β} {inst_2 : Add F} [self : IsAddApply F α β] (f g : F) (x : α), (f + g) x = f x + g x
@_root_.sum_apply : ∀ {F : Type u_1} {α : Type u_2} {β : Type u_3} {ι : Type u_4} [inst : FunLike F α β]
  [inst_1 : AddCommMonoid β] [inst_2 : AddCommMonoid F] [IsZeroApply F α β] [IsAddApply F α β] (s : Finset ι)
  (f : ι → F) (x : α), (∑ i ∈ s, f i) x = ∑ i ∈ s, (f i) x
@smul_apply : ∀ {M : Type u_1} {F : Type u_2} {α : outParam (Type u_3)} {β : outParam (Type u_4)} {inst : FunLike F α β}
  {inst_1 : SMul M β} {inst_2 : SMul M F} [self : IsSMulApply M F α β] (f : F) (r : M) (x : α), (r • f) x = r • f x
@zero_apply : ∀ {F : Type u_1} {α : outParam (Type u_2)} {β : outParam (Type u_3)} {inst : FunLike F α β}
  {inst_1 : Zero β} {inst_2 : Zero F} [self : IsZeroApply F α β] (x : α), 0 x = 0
rc=0
