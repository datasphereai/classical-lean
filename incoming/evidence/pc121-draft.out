def EfronStein.wmean.{u_1} : {α : Type u_1} → [Fintype α] → (α → ℝ) → (α → ℝ) → ℝ :=
fun {α} [Fintype α] r h ↦ ∑ a, r a * h a
def EfronStein.wvar.{u_1} : {α : Type u_1} → [Fintype α] → (α → ℝ) → (α → ℝ) → ℝ :=
fun {α} [Fintype α] r h ↦ ∑ a, r a * (h a - EfronStein.wmean r h) ^ 2
def EfronStein.weight.{u_1} : {n : ℕ} → {Ω : Fin n → Type u_1} → ((i : Fin n) → Ω i → ℝ) → ((i : Fin n) → Ω i) → ℝ :=
fun {n} {Ω} p x ↦ ∏ i, p i (x i)
def EfronStein.expect.{u_1} : {n : ℕ} →
  {Ω : Fin n → Type u_1} → [(i : Fin n) → Fintype (Ω i)] → ((i : Fin n) → Ω i → ℝ) → (((i : Fin n) → Ω i) → ℝ) → ℝ :=
fun {n} {Ω} [(i : Fin n) → Fintype (Ω i)] p f ↦ EfronStein.wmean (EfronStein.weight p) f
def EfronStein.variance.{u_1} : {n : ℕ} →
  {Ω : Fin n → Type u_1} → [(i : Fin n) → Fintype (Ω i)] → ((i : Fin n) → Ω i → ℝ) → (((i : Fin n) → Ω i) → ℝ) → ℝ :=
fun {n} {Ω} [(i : Fin n) → Fintype (Ω i)] p f ↦ EfronStein.wvar (EfronStein.weight p) f
def EfronStein.coordVar.{u_1} : {n : ℕ} →
  {Ω : Fin n → Type u_1} →
    [(i : Fin n) → Fintype (Ω i)] →
      ((i : Fin n) → Ω i → ℝ) → Fin n → (((i : Fin n) → Ω i) → ℝ) → ((i : Fin n) → Ω i) → ℝ :=
fun {n} {Ω} [(i : Fin n) → Fintype (Ω i)] p i f x ↦ EfronStein.wvar (p i) fun a ↦ f (Function.update x i a)
rc=0
