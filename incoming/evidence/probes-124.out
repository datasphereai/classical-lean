  [inst_3 : PartialOrder β] [IsOrderedAddMonoid β] [inst_5 : Module 𝕜 β] [PosSMulMono 𝕜 β] (r : β), Convex 𝕜 (Set.Ici r)
@deriv : {𝕜 : Type u_1} →
  [inst : NontriviallyNormedField 𝕜] →
    {F : Type u_2} → [inst_1 : AddCommGroup F] → [Module 𝕜 F] → [TopologicalSpace F] → (𝕜 → F) → 𝕜 → F
@div_lt_iff₀ : ∀ {G₀ : Type u_1} [inst : GroupWithZero G₀] [inst_1 : PartialOrder G₀] [MulPosReflectLT G₀] {a b c : G₀},
  0 < c → (b / c < a ↔ b < a * c)
@div_mul_cancel₀ : ∀ {G₀ : Type u_1} [inst : GroupWithZero G₀] {b : G₀} (a : G₀), b ≠ 0 → a / b * b = a
@div_mul_eq_mul_div : ∀ {α : Type u_1} [inst : DivisionCommMonoid α] (a b c : α), a / b * c = a * c / b
@div_nonneg : ∀ {G₀ : Type u_1} [inst : GroupWithZero G₀] [inst_1 : PartialOrder G₀] [PosMulReflectLT G₀] {a b : G₀},
  0 ≤ a → 0 ≤ b → 0 ≤ a / b
@div_nonneg_of_nonpos : ∀ {α : Type u_1} [inst : Field α] [inst_1 : PartialOrder α] [PosMulReflectLT α]
  [IsStrictOrderedRing α] {a b : α}, a ≤ 0 → b ≤ 0 → 0 ≤ a / b
@eq_div_iff : ∀ {G₀ : Type u_1} [inst : GroupWithZero G₀] {a b c : G₀}, b ≠ 0 → (c = a / b ↔ c * b = a)
@eq_or_lt_of_le : ∀ {α : Type u_1} [inst : PartialOrder α] {a b : α}, a ≤ b → a = b ∨ a < b
@hasDerivAt_const : ∀ {𝕜 : Type u_1} [inst : NontriviallyNormedField 𝕜] {F : Type u_2} [inst_1 : NormedAddCommGroup F]
  [inst_2 : NormedSpace 𝕜 F] (x : 𝕜) (c : F), HasDerivAt (fun x ↦ c) 0 x
@hasDerivAt_id' : ∀ {𝕜 : Type u_1} [inst : NontriviallyNormedField 𝕜] (x : 𝕜), HasDerivAt (fun x ↦ x) 1 x
@interior_Ici : ∀ {α : Type u_1} [inst : TopologicalSpace α] [inst_1 : LinearOrder α] [OrderTopology α]
  [DenselyOrdered α] [NoMinOrder α] {a : α}, interior (Set.Ici a) = Set.Ioi a
@le_div_iff₀ : ∀ {G₀ : Type u_1} [inst : GroupWithZero G₀] [inst_1 : PartialOrder G₀] [MulPosReflectLT G₀] {a b c : G₀},
  0 < c → (a ≤ b / c ↔ a * c ≤ b)
@le_of_eq : ∀ {α : Type u_1} [inst : Preorder α] {a b : α}, a = b → a ≤ b
@le_rfl : ∀ {α : Type u_1} [inst : Preorder α] {a : α}, a ≤ a
@le_total : ∀ {α : Type u_1} [inst : LinearOrder α] (a b : α), a ≤ b ∨ b ≤ a
@le_trans : ∀ {α : Type u_1} [inst : Preorder α] {a b c : α}, a ≤ b → b ≤ c → a ≤ c
@measurableSet_Iic : ∀ {α : Type u_1} [inst : TopologicalSpace α] {mα : MeasurableSpace α} [OpensMeasurableSpace α]
  [inst_2 : Preorder α] {a : α} [ClosedIicTopology α], MeasurableSet (Set.Iic a)
@measurable_pi_apply : ∀ {δ : Type u_1} {X : δ → Type u_2} [inst : (a : δ) → MeasurableSpace (X a)] (a : δ),
  Measurable fun f ↦ f a
@monotoneOn_of_deriv_nonneg : ∀ {D : Set ℝ},
  Convex ℝ D →
    ∀ {f : ℝ → ℝ},
      ContinuousOn f D → DifferentiableOn ℝ f (interior D) → (∀ x ∈ interior D, 0 ≤ deriv f x) → MonotoneOn f D
@mul_assoc : ∀ {G : Type u_1} [inst : Semigroup G] (a b c : G), a * b * c = a * (b * c)
@mul_le_mul : ∀ {α : Type u_1} [inst : Mul α] [inst_1 : Zero α] [inst_2 : Preorder α] {a b c d : α} [PosMulMono α]
  [MulPosMono α], a ≤ b → c ≤ d → 0 ≤ c → 0 ≤ b → a * c ≤ b * d
@mul_le_mul_of_nonneg_left : ∀ {α : Type u_1} [inst : Mul α] [inst_1 : Zero α] [inst_2 : Preorder α] {a b c : α}
  [PosMulMono α], b ≤ c → 0 ≤ a → a * b ≤ a * c
@mul_nonneg : ∀ {α : Type u_1} [inst : MulZeroClass α] {a b : α} [inst_1 : Preorder α] [PosMulMono α],
  0 ≤ a → 0 ≤ b → 0 ≤ a * b
@neg_zero : ∀ {G : Type u_1} [inst : NegZeroClass G], -0 = 0
@nsmul_eq_mul : ∀ {α : Type u_1} [inst : NonAssocSemiring α] (n : ℕ) (a : α), n • a = ↑n * a
@one_mul : ∀ {M : Type u_1} [inst : MulOneClass M] (a : M), 1 * a = a
@rfl : ∀ {α : Sort u_1} {a : α}, a = a
@sq_nonneg : ∀ {R : Type u_1} [inst : Semiring R] [inst_1 : LinearOrder R] [ExistsAddOfLE R] [PosMulMono R]
  [AddLeftMono R] (a : R), 0 ≤ a ^ 2
@sub_nonneg : ∀ {α : Type u_1} [inst : AddGroup α] [inst_1 : LE α] [AddRightMono α] {a b : α}, 0 ≤ a - b ↔ b ≤ a
rc=0
