  {ι : Type u_4} {u : Finset ι} {A : ι → E → F} {A' : ι → E →L[𝕜] F},
  (∀ i ∈ u, HasFDerivAt (A i) (A' i) x) → HasFDerivAt (∑ i ∈ u, A i) (∑ i ∈ u, A' i) x
