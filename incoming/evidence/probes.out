  [inst_4 : NormedAlgebra 𝕜 𝔸] {a : E → 𝔸} {a' : E →L[𝕜] 𝔸},
  HasFDerivAt a a' x → ∀ (b : 𝔸), HasFDerivAt (fun y ↦ b * a y) (b • a') x
