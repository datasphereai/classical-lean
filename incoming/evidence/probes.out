@sub_self : ∀ {G : Type u_1} [inst : AddGroup G] (a : G), a - a = 0
@sub_zero : ∀ {G : Type u_1} [inst : SubNegZeroMonoid G] (a : G), a - 0 = a
@sum_inner : ∀ {𝕜 : Type u_1} {E : Type u_2} [inst : RCLike 𝕜] [inst_1 : SeminormedAddCommGroup E]
  [inst_2 : InnerProductSpace 𝕜 E] {ι : Type u_3} (s : Finset ι) (f : ι → E) (x : E),
  inner 𝕜 (∑ i ∈ s, f i) x = ∑ i ∈ s, inner 𝕜 (f i) x
@tendsto_nhdsWithin_iff : ∀ {α : Type u_1} {β : Type u_2} [inst : TopologicalSpace α] {a : α} {l : Filter β} {s : Set α}
  {f : β → α}, Filter.Tendsto f l (nhdsWithin a s) ↔ Filter.Tendsto f l (nhds a) ∧ ∀ᶠ (n : β) in l, f n ∈ s
@tendsto_pow_atTop_nhds_zero_of_lt_one : ∀ {𝕜 : Type u_1} [inst : Semifield 𝕜] [inst_1 : LinearOrder 𝕜]
  [IsStrictOrderedRing 𝕜] [ExistsAddOfLE 𝕜] [Archimedean 𝕜] [inst_5 : TopologicalSpace 𝕜] [OrderTopology 𝕜] {r : 𝕜},
  0 ≤ r → r < 1 → Filter.Tendsto (fun n ↦ r ^ n) Filter.atTop (nhds 0)
@tendsto_sub_nhds_zero_iff : ∀ {G : Type u_1} [inst : AddGroup G] [inst_1 : TopologicalSpace G]
  [IsTopologicalAddGroup G] {α : Type u_2} {l : Filter α} {x : G} {u : α → G},
  Filter.Tendsto (fun x_1 ↦ u x_1 - x) l (nhds 0) ↔ Filter.Tendsto u l (nhds x)
@two_pos : ∀ {α : Type u_1} [inst : AddMonoidWithOne α] [inst_1 : PartialOrder α] [ZeroLEOneClass α] [NeZero 1]
  [AddLeftMono α], 0 < 2
@zero_add : ∀ {M : Type u_1} [inst : AddZeroClass M] (a : M), 0 + a = a
@zero_dotProduct : ∀ {m : Type u_2} {α : Type u_1} [inst : Fintype m] [inst_1 : NonUnitalNonAssocSemiring α]
  (v : m → α), 0 ⬝ᵥ v = 0
rc=0
