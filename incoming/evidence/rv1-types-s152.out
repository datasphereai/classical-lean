@ClassicalLean.Analysis.KKT.convex_comb_lt : ∀ {s t a b c d : ℝ},
  0 ≤ s → 0 ≤ t → s + t = 1 → a < b → c < d → s * a + t * c < s * b + t * d
@ClassicalLean.Analysis.KKT.exists_kkt_of_slater : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : CompleteSpace E] {ι : Type u_2} [inst_3 : Fintype ι] {f : E → ℝ}
  {g : ι → E → ℝ} {xbar a : E} {b : ι → E},
  ConvexOn ℝ Set.univ f →
    (∀ (i : ι), ConvexOn ℝ Set.univ (g i)) →
      HasGradientAt f a xbar →
        (∀ (i : ι), HasGradientAt (g i) (b i) xbar) →
          (∃ x0, ∀ (i : ι), g i x0 < 0) →
            (∀ (i : ι), g i xbar ≤ 0) →
              IsMinOn f {x | ∀ (i : ι), g i x ≤ 0} xbar →
                ∃ w, (∀ (i : ι), 0 ≤ w i) ∧ (∀ (i : ι), w i * g i xbar = 0) ∧ a + ∑ i, w i • b i = 0
rc=0
