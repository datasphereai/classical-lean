@ClassicalLean.Simplex.mutualInfo : {α : Type u_1} → {β : Type u_2} → [Fintype α] → [Fintype β] → (α × β → ℝ) → ℝ
@ClassicalLean.Simplex.mutualInfo_eq_shannonEntropy_add_shannonEntropy_sub_shannonEntropy : ∀ {α : Type u_1}
  {β : Type u_2} [inst : Fintype α] [inst_1 : Fintype β] {P : α × β → ℝ},
  (∀ (ab : α × β), 0 ≤ P ab) →
    ClassicalLean.Simplex.mutualInfo P =
      ((ClassicalLean.Simplex.shannonEntropy fun a ↦ ∑ b, P (a, b)) +
          ClassicalLean.Simplex.shannonEntropy fun b ↦ ∑ a, P (a, b)) -
        ClassicalLean.Simplex.shannonEntropy P
