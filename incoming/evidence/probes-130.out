@eq_or_ne : ∀ {α : Sort u_1} (x y : α), x = y ∨ x ≠ y
@funext : ∀ {α : Sort u_1} {β : α → Sort u_2} {f g : (x : α) → β x}, (∀ (x : α), f x = g x) → f = g
