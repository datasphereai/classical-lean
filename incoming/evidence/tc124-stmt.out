@ClassicalLean.Probability.BernsteinInequality.measureReal_sum_ge_le_bernstein : ∀ {Ω : Type u_1} {ι : Type u_2}
  [inst : MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω} [MeasureTheory.IsProbabilityMeasure μ] {X : ι → Ω → ℝ}
  (s : Finset ι),
  ProbabilityTheory.iIndepFun X μ →
    (∀ (i : ι), Measurable (X i)) →
      (∀ i ∈ s, MeasureTheory.Integrable (X i) μ) →
        (∀ i ∈ s, MeasureTheory.Integrable (fun ω ↦ X i ω ^ 2) μ) →
          (∀ i ∈ s, ∫ (ω : Ω), X i ω ∂μ = 0) →
            ∀ {b v t : ℝ},
              0 ≤ b →
                (∀ i ∈ s, ∀ᵐ (ω : Ω) ∂μ, X i ω ≤ b) →
                  ∑ i ∈ s, ∫ (ω : Ω), X i ω ^ 2 ∂μ ≤ v →
                    0 ≤ t → μ.real {ω | t ≤ ∑ i ∈ s, X i ω} ≤ Real.exp (-t ^ 2 / (2 * (v + b * t / 3)))
rc=0
