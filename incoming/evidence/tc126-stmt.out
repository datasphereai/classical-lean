  {μ : MeasureTheory.Measure Ω} [MeasureTheory.IsProbabilityMeasure μ] {n : ℕ} {X : Fin n → Ω → ℝ},
  (∀ (i : Fin n), Measurable (X i)) →
    ProbabilityTheory.iIndepFun X μ →
      ∀ {x F : ℝ},
