@ClassicalLean.InformationTheory.Huffman.exists_pair : ∀ {ι : Type u_1} (w : ι → ℝ) (s : Finset ι),
  2 ≤ #s → ∃ ab, ab.1 ∈ s ∧ ab.2 ∈ s ∧ ab.1 ≠ ab.2 ∧ (∀ x ∈ s, w ab.1 ≤ w x) ∧ ∀ x ∈ s, x ≠ ab.1 → w ab.2 ≤ w x
@ClassicalLean.InformationTheory.Huffman.pick : {ι : Type u_1} → (ι → ℝ) → (s : Finset ι) → 2 ≤ #s → ι × ι
@ClassicalLean.InformationTheory.Huffman.pick_spec : ∀ {ι : Type u_1} (w : ι → ℝ) (s : Finset ι) (h : 2 ≤ #s),
  (ClassicalLean.InformationTheory.Huffman.pick w s h).1 ∈ s ∧
    (ClassicalLean.InformationTheory.Huffman.pick w s h).2 ∈ s ∧
      (ClassicalLean.InformationTheory.Huffman.pick w s h).1 ≠ (ClassicalLean.InformationTheory.Huffman.pick w s h).2 ∧
        (∀ x ∈ s, w (ClassicalLean.InformationTheory.Huffman.pick w s h).1 ≤ w x) ∧
          ∀ x ∈ s,
            x ≠ (ClassicalLean.InformationTheory.Huffman.pick w s h).1 →
              w (ClassicalLean.InformationTheory.Huffman.pick w s h).2 ≤ w x
@ClassicalLean.InformationTheory.Huffman.mergeLen : {ι : Type u_1} → [DecidableEq ι] → (ι → ℕ) → ι → ι → ι → ℕ
@ClassicalLean.InformationTheory.Huffman.mergeW : {ι : Type u_1} → [DecidableEq ι] → (ι → ℝ) → ι → ι → ι → ℝ
@ClassicalLean.InformationTheory.Huffman.huffAux : {ι : Type u_1} → [DecidableEq ι] → ℕ → (ι → ℝ) → Finset ι → ι → ℕ
@ClassicalLean.InformationTheory.Huffman.huffmanLength : {ι : Type u_1} →
  [DecidableEq ι] → [Fintype ι] → (ι → ℝ) → ι → ℕ
@ClassicalLean.InformationTheory.Huffman.huffAux_zero : ∀ {ι : Type u_1} [inst : DecidableEq ι] (w : ι → ℝ)
  (s : Finset ι), ClassicalLean.InformationTheory.Huffman.huffAux 0 w s = fun x ↦ 0
@ClassicalLean.InformationTheory.Huffman.huffAux_succ : ∀ {ι : Type u_1} [inst : DecidableEq ι] (n : ℕ) (w : ι → ℝ)
  (s : Finset ι) (h : 2 ≤ #s),
  ClassicalLean.InformationTheory.Huffman.huffAux (n + 1) w s =
    ClassicalLean.InformationTheory.Huffman.mergeLen
      (ClassicalLean.InformationTheory.Huffman.huffAux n
        (ClassicalLean.InformationTheory.Huffman.mergeW w (ClassicalLean.InformationTheory.Huffman.pick w s h).1
          (ClassicalLean.InformationTheory.Huffman.pick w s h).2)
        (s.erase (ClassicalLean.InformationTheory.Huffman.pick w s h).2))
      (ClassicalLean.InformationTheory.Huffman.pick w s h).1 (ClassicalLean.InformationTheory.Huffman.pick w s h).2
@ClassicalLean.InformationTheory.Huffman.huffAux_succ_of_not : ∀ {ι : Type u_1} [inst : DecidableEq ι] (n : ℕ)
  (w : ι → ℝ) (s : Finset ι), ¬2 ≤ #s → ClassicalLean.InformationTheory.Huffman.huffAux (n + 1) w s = fun x ↦ 0
@ClassicalLean.InformationTheory.Huffman.mergeLen_left : ∀ {ι : Type u_1} [inst : DecidableEq ι] {ℓ : ι → ℕ} {a b : ι},
  a ≠ b → ClassicalLean.InformationTheory.Huffman.mergeLen ℓ a b a = ℓ a + 1
@ClassicalLean.InformationTheory.Huffman.mergeLen_right : ∀ {ι : Type u_1} [inst : DecidableEq ι] {ℓ : ι → ℕ} {a b : ι},
  ClassicalLean.InformationTheory.Huffman.mergeLen ℓ a b b = ℓ a + 1
@ClassicalLean.InformationTheory.Huffman.mergeLen_of_ne : ∀ {ι : Type u_1} [inst : DecidableEq ι] {ℓ : ι → ℕ}
  {a b z : ι}, z ≠ a → z ≠ b → ClassicalLean.InformationTheory.Huffman.mergeLen ℓ a b z = ℓ z
@ClassicalLean.InformationTheory.Huffman.mergeW_self : ∀ {ι : Type u_1} [inst : DecidableEq ι] (w : ι → ℝ) (a b : ι),
  ClassicalLean.InformationTheory.Huffman.mergeW w a b a = w a + w b
@ClassicalLean.InformationTheory.Huffman.mergeW_of_ne : ∀ {ι : Type u_1} [inst : DecidableEq ι] {w : ι → ℝ} {a b z : ι},
  z ≠ a → ClassicalLean.InformationTheory.Huffman.mergeW w a b z = w z
@ClassicalLean.InformationTheory.Huffman.mergeW_nonneg : ∀ {ι : Type u_1} [inst : DecidableEq ι] {w : ι → ℝ},
  (∀ (i : ι), 0 ≤ w i) → ∀ (a b i : ι), 0 ≤ ClassicalLean.InformationTheory.Huffman.mergeW w a b i
@ClassicalLean.InformationTheory.Huffman.sum_split : ∀ {ι : Type u_1} [inst : DecidableEq ι] {s : Finset ι} {a b : ι},
  a ∈ s → b ∈ s → a ≠ b → ∀ (f : ι → ℝ), ∑ i ∈ s, f i = f a + f b + ∑ i ∈ (s.erase b).erase a, f i
@ClassicalLean.InformationTheory.Huffman.sum_erase_split : ∀ {ι : Type u_1} [inst : DecidableEq ι] {s : Finset ι}
  {a b : ι}, a ∈ s → a ≠ b → ∀ (f : ι → ℝ), ∑ i ∈ s.erase b, f i = f a + ∑ i ∈ (s.erase b).erase a, f i
@ClassicalLean.InformationTheory.Huffman.swap_mem : ∀ {ι : Type u_1} [inst : DecidableEq ι] {s : Finset ι} {u v z : ι},
  u ∈ s → v ∈ s → z ∈ s → (Equiv.swap u v) z ∈ s
@ClassicalLean.InformationTheory.Huffman.sum_swap : ∀ {ι : Type u_1} [inst : DecidableEq ι] {s : Finset ι} {u v : ι},
  u ∈ s →
    v ∈ s →
      ∀ (F : ι → ℕ → ℝ) (ℓ : ι → ℕ),
        ∑ z ∈ s, F z (ℓ ((Equiv.swap u v) z)) = ∑ z ∈ s, F z (ℓ z) + (F u (ℓ v) + F v (ℓ u) - F u (ℓ u) - F v (ℓ v))
@ClassicalLean.InformationTheory.Huffman.two_pow_mul_half_pow : ∀ {k M : ℕ},
  k ≤ M → 2 ^ M * (1 / 2) ^ k = ↑(2 ^ (M - k))
@ClassicalLean.InformationTheory.Huffman.kraft_mergeLen : ∀ {ι : Type u_1} [inst : DecidableEq ι] {s : Finset ι}
  {a b : ι},
  a ∈ s →
    b ∈ s →
      a ≠ b →
        ∀ (ℓ : ι → ℕ),
          ∑ i ∈ s, (1 / 2) ^ ClassicalLean.InformationTheory.Huffman.mergeLen ℓ a b i = ∑ i ∈ s.erase b, (1 / 2) ^ ℓ i
@ClassicalLean.InformationTheory.Huffman.cost_mergeLen : ∀ {ι : Type u_1} [inst : DecidableEq ι] (w : ι → ℝ)
  {s : Finset ι} {a b : ι},
  a ∈ s →
    b ∈ s →
      a ≠ b →
        ∀ (ℓ : ι → ℕ),
          ∑ i ∈ s, w i * ↑(ClassicalLean.InformationTheory.Huffman.mergeLen ℓ a b i) =
            ∑ i ∈ s.erase b, ClassicalLean.InformationTheory.Huffman.mergeW w a b i * ↑(ℓ i) + w a + w b
@ClassicalLean.InformationTheory.Huffman.merge_step : ∀ {ι : Type u_1} [inst : DecidableEq ι] {w : ι → ℝ},
  (∀ (i : ι), 0 ≤ w i) →
    ∀ {s : Finset ι} {a b : ι},
      a ∈ s →
        b ∈ s →
          a ≠ b →
            ∀ {ℓ : ι → ℕ},
              ℓ b ≤ ℓ a →
                (∀ z ∈ s, z ≠ a → ℓ z ≤ ℓ b) →
                  ∑ i ∈ s, (1 / 2) ^ ℓ i ≤ 1 →
                    ∃ ℓ',
                      ∑ i ∈ s.erase b, (1 / 2) ^ ℓ' i ≤ 1 ∧
                        ∑ i ∈ s.erase b, ClassicalLean.InformationTheory.Huffman.mergeW w a b i * ↑(ℓ' i) + w a + w b ≤
                          ∑ i ∈ s, w i * ↑(ℓ i)
@ClassicalLean.InformationTheory.Huffman.reduce_step : ∀ {ι : Type u_1} [inst : DecidableEq ι] {w : ι → ℝ},
  (∀ (i : ι), 0 ≤ w i) →
    ∀ {s : Finset ι} {a b : ι},
      a ∈ s →
        b ∈ s →
          a ≠ b →
            (∀ x ∈ s, w a ≤ w x) →
              (∀ x ∈ s, x ≠ a → w b ≤ w x) →
                ∀ {ℓ : ι → ℕ},
                  ∑ i ∈ s, (1 / 2) ^ ℓ i ≤ 1 →
                    ∃ ℓ',
                      ∑ i ∈ s.erase b, (1 / 2) ^ ℓ' i ≤ 1 ∧
                        ∑ i ∈ s.erase b, ClassicalLean.InformationTheory.Huffman.mergeW w a b i * ↑(ℓ' i) + w a + w b ≤
                          ∑ i ∈ s, w i * ↑(ℓ i)
@ClassicalLean.InformationTheory.Huffman.huffAux_kraft : ∀ {ι : Type u_1} [inst : DecidableEq ι] (n : ℕ) (w : ι → ℝ)
  (s : Finset ι), #s = n → ∑ i ∈ s, (1 / 2) ^ ClassicalLean.InformationTheory.Huffman.huffAux n w s i ≤ 1
@ClassicalLean.InformationTheory.Huffman.huffAux_opt : ∀ {ι : Type u_1} [inst : DecidableEq ι] (n : ℕ) (w : ι → ℝ)
  (s : Finset ι),
  (∀ (i : ι), 0 ≤ w i) →
    #s = n →
      ∀ (ℓ : ι → ℕ),
        ∑ i ∈ s, (1 / 2) ^ ℓ i ≤ 1 →
          ∑ i ∈ s, w i * ↑(ClassicalLean.InformationTheory.Huffman.huffAux n w s i) ≤ ∑ i ∈ s, w i * ↑(ℓ i)
@ClassicalLean.InformationTheory.Huffman.huffman_optimal : ∀ {ι : Type u_1} {α : Type u_2} [inst : Fintype ι]
  [inst_1 : DecidableEq ι] [inst_2 : Fintype α],
  Fintype.card α = 2 →
    ∀ {p : ι → ℝ},
      (∀ (i : ι), 0 ≤ p i) →
        ∃ c,
          Function.Injective c ∧
            InformationTheory.IsPrefixFree (Set.range c) ∧
              (∀ (i : ι), (c i).length = ClassicalLean.InformationTheory.Huffman.huffmanLength p i) ∧
                ∀ (c' : ι → List α),
                  Function.Injective c' →
                    InformationTheory.IsPrefixFree (Set.range c') → ∑ i, p i * ↑(c i).length ≤ ∑ i, p i * ↑(c' i).length
rc=0
