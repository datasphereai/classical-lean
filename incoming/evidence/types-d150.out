@pinv : {m : Type u_3} → {n : Type u_4} → [Fintype m] → [Fintype n] → [DecidableEq n] → Matrix m n ℝ → Matrix n m ℝ
def pinv.{u_1, u_2} : {m : Type u_1} →
  {n : Type u_2} → [Fintype m] → [Fintype n] → [DecidableEq n] → Matrix m n ℝ → Matrix n m ℝ :=
fun {m} {n} [Fintype m] [Fintype n] [DecidableEq n] A ↦ Classical.choose ⋯
@pinv_spec : ∀ {m : Type u_3} {n : Type u_4} [inst : Fintype m] [inst_1 : Fintype n] [inst_2 : DecidableEq n]
  (A : Matrix m n ℝ),
  A * pinv A * A = A ∧ pinv A * A * pinv A = pinv A ∧ (A * pinv A)ᵀ = A * pinv A ∧ (pinv A * A)ᵀ = pinv A * A
@pinv_unique : ∀ {m : Type u_3} {n : Type u_4} [inst : Fintype m] [inst_1 : Fintype n] [inst_2 : DecidableEq n]
  {A : Matrix m n ℝ} {X : Matrix n m ℝ},
  A * X * A = A → X * A * X = X → (A * X)ᵀ = A * X → (X * A)ᵀ = X * A → X = pinv A
@pinv_residual_dotProduct_le : ∀ {m : Type u_3} {n : Type u_4} [inst : Fintype m] [inst_1 : Fintype n]
  [inst_2 : DecidableEq n] (A : Matrix m n ℝ) (y : m → ℝ) (β : n → ℝ),
  (y - A *ᵥ pinv A *ᵥ y) ⬝ᵥ (y - A *ᵥ pinv A *ᵥ y) ≤ (y - A *ᵥ β) ⬝ᵥ (y - A *ᵥ β)
@pinv_eq_leastSquares : ∀ {m : Type u_3} {n : Type u_4} [inst : Fintype m] [inst_1 : Fintype n] [inst_2 : DecidableEq n]
  {A : Matrix m n ℝ}, IsUnit (Aᵀ * A).det → pinv A = ClassicalLean.Statistics.leastSquares A
rc=0
