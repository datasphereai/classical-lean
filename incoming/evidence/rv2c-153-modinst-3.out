@pick : {ι : Type u_1} → (ι → ℝ) → (s : Finset ι) → 2 ≤ #s → ι × ι
@mergeLen : {ι : Type u_1} → [DecidableEq ι] → (ι → ℕ) → ι → ι → ι → ℕ
