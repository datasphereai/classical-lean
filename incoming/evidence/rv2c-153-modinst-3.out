@merge_step : ∀ {ι : Type u_1} [inst : DecidableEq ι] {w : ι → ℝ},
  (∀ (i : ι), 0 ≤ w i) →
    ∀ {s : Finset ι} {a b : ι},
      a ∈ s →
        b ∈ s →
          a ≠ b →
            ∀ {ℓ : ι → ℕ},
              ℓ b ≤ ℓ a →
                (∀ z ∈ s, z ≠ a → ℓ z ≤ ℓ b) →
