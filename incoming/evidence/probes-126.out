@ProbabilityTheory.bernoulliMeasure_real_apply : ∀ {X : Type u_1} [inst : MeasurableSpace X] {x y : X}
  (p : ↑unitInterval) {s : Set X},
  MeasurableSet s →
    ∀ [inst_1 : DecidablePred fun x ↦ x ∈ s],
      (ProbabilityTheory.bernoulliMeasure x y p).real s =
        if x ∈ s then if y ∈ s then 1 else ↑(unitInterval.toNNReal p)
        else if y ∈ s then ↑(unitInterval.toNNReal (unitInterval.symm p)) else 0
