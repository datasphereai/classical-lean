bscJoint : ℝ → (Fin 2 → ℝ) → Fin 2 × Fin 2 → ℝ
bscJoint_values : ∀ (ε : ℝ) (p : Fin 2 → ℝ),
  bscJoint ε p (0, 0) = p 0 * (1 - ε) ∧
    bscJoint ε p (0, 1) = p 0 * ε ∧ bscJoint ε p (1, 0) = p 1 * ε ∧ bscJoint ε p (1, 1) = p 1 * (1 - ε)
@bscJoint_nonneg : ∀ {ε : ℝ},
  0 ≤ ε → ε ≤ 1 → ∀ {p : Fin 2 → ℝ}, (∀ (a : Fin 2), 0 ≤ p a) → ∀ (ab : Fin 2 × Fin 2), 0 ≤ bscJoint ε p ab
mul_mul_log_mul : ∀ (x y : ℝ), x * y * Real.log (x * y) = y * (x * Real.log x) + x * (y * Real.log y)
@mutualInfo_bscJoint : ∀ {ε : ℝ},
  0 ≤ ε →
    ε ≤ 1 →
      ∀ {p : Fin 2 → ℝ},
        (∀ (a : Fin 2), 0 ≤ p a) →
          ∑ a, p a = 1 →
            ClassicalLean.Simplex.mutualInfo (bscJoint ε p) =
              (ClassicalLean.Simplex.shannonEntropy fun b ↦ ∑ a, bscJoint ε p (a, b)) - Real.binEntropy ε
@bscJoint_output_half : ∀ {ε : ℝ} {p : Fin 2 → ℝ},
  (∀ (a : Fin 2), p a = 1 / 2) → (fun b ↦ ∑ a, bscJoint ε p (a, b)) = fun x ↦ 2⁻¹
@mutualInfo_bsc_le : ∀ {ε : ℝ},
  0 ≤ ε →
    ε ≤ 1 →
      ∀ {p : Fin 2 → ℝ},
        (∀ (a : Fin 2), 0 ≤ p a) →
          ∑ a, p a = 1 →
            (ClassicalLean.Simplex.mutualInfo fun ab ↦ p ab.1 * if ab.1 = ab.2 then 1 - ε else ε) ≤
              Real.log 2 - Real.binEntropy ε
@mutualInfo_bsc_half : ∀ {ε : ℝ},
  0 ≤ ε →
    ε ≤ 1 →
      (ClassicalLean.Simplex.mutualInfo fun ab ↦ 1 / 2 * if ab.1 = ab.2 then 1 - ε else ε) =
        Real.log 2 - Real.binEntropy ε
rc=0
