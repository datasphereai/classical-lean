def ClassicalLean.Probability.EfronStein.wmean.{u_1} : {α : Type u_1} → [Fintype α] → (α → ℝ) → (α → ℝ) → ℝ :=
fun {α} [Fintype α] r h ↦ ∑ a, r a * h a
def ClassicalLean.Probability.EfronStein.wvar.{u_1} : {α : Type u_1} → [Fintype α] → (α → ℝ) → (α → ℝ) → ℝ :=
fun {α} [Fintype α] r h ↦ ∑ a, r a * (h a - ClassicalLean.Probability.EfronStein.wmean r h) ^ 2
def ClassicalLean.Probability.EfronStein.weight.{u_1} : {n : ℕ} →
  {Ω : Fin n → Type u_1} → ((i : Fin n) → Ω i → ℝ) → ((i : Fin n) → Ω i) → ℝ :=
fun {n} {Ω} p x ↦ ∏ i, p i (x i)
def ClassicalLean.Probability.EfronStein.expect.{u_1} : {n : ℕ} →
  {Ω : Fin n → Type u_1} → [(i : Fin n) → Fintype (Ω i)] → ((i : Fin n) → Ω i → ℝ) → (((i : Fin n) → Ω i) → ℝ) → ℝ :=
fun {n} {Ω} [(i : Fin n) → Fintype (Ω i)] p f ↦
  ClassicalLean.Probability.EfronStein.wmean (ClassicalLean.Probability.EfronStein.weight p) f
def ClassicalLean.Probability.EfronStein.variance.{u_1} : {n : ℕ} →
  {Ω : Fin n → Type u_1} → [(i : Fin n) → Fintype (Ω i)] → ((i : Fin n) → Ω i → ℝ) → (((i : Fin n) → Ω i) → ℝ) → ℝ :=
fun {n} {Ω} [(i : Fin n) → Fintype (Ω i)] p f ↦
  ClassicalLean.Probability.EfronStein.wvar (ClassicalLean.Probability.EfronStein.weight p) f
def ClassicalLean.Probability.EfronStein.coordVar.{u_1} : {n : ℕ} →
  {Ω : Fin n → Type u_1} →
    [(i : Fin n) → Fintype (Ω i)] →
      ((i : Fin n) → Ω i → ℝ) → Fin n → (((i : Fin n) → Ω i) → ℝ) → ((i : Fin n) → Ω i) → ℝ :=
fun {n} {Ω} [(i : Fin n) → Fintype (Ω i)] p i f x ↦
  ClassicalLean.Probability.EfronStein.wvar (p i) fun a ↦ f (Function.update x i a)
