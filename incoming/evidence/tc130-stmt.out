  ClassicalLean.InformationTheory.ChannelCapacity.bscJoint ε p (0, 0) = p 0 * (1 - ε) ∧
    ClassicalLean.InformationTheory.ChannelCapacity.bscJoint ε p (0, 1) = p 0 * ε ∧
      ClassicalLean.InformationTheory.ChannelCapacity.bscJoint ε p (1, 0) = p 1 * ε ∧
        ClassicalLean.InformationTheory.ChannelCapacity.bscJoint ε p (1, 1) = p 1 * (1 - ε)
