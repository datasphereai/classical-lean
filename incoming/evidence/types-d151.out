@hasLaw_sum_sq_gaussian : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {P : MeasureTheory.Measure Ω}
  [MeasureTheory.IsProbabilityMeasure P] {k : ℕ},
  0 < k →
    ∀ {X : Fin k → Ω → ℝ},
      (∀ (i : Fin k), Measurable (X i)) →
        ProbabilityTheory.iIndepFun X P →
          (∀ (i : Fin k), ProbabilityTheory.HasLaw (X i) (ProbabilityTheory.gaussianReal 0 1) P) →
            ProbabilityTheory.HasLaw (fun ω ↦ ∑ i, X i ω ^ 2) (ProbabilityTheory.gammaMeasure (↑k / 2) (1 / 2)) P
rc=0
