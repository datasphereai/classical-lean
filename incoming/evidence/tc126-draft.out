@orderStat : {n : ℕ} → (Fin n → ℝ) → Fin n → ℝ
@measureReal_orderStat_le : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
  [MeasureTheory.IsProbabilityMeasure μ] {n : ℕ} {X : Fin n → Ω → ℝ},
  (∀ (i : Fin n), Measurable (X i)) →
    ProbabilityTheory.iIndepFun X μ →
      ∀ {x F : ℝ},
        (∀ (i : Fin n), μ.real {ω | X i ω ≤ x} = F) →
          ∀ (k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n),
            μ.real {ω | orderStat (fun i ↦ X i ω) ⟨k - 1, ⋯⟩ ≤ x} =
              ∑ j ∈ Finset.Icc k n, ↑(n.choose j) * F ^ j * (1 - F) ^ (n - j)
rc=0
