@ClassicalLean.InformationTheory.Huffman.huffman_optimal : ∀ {ι : Type u_1} {α : Type u_2} [inst : Fintype ι]
  [inst_1 : DecidableEq ι] [inst_2 : Fintype α],
  Fintype.card α = 2 →
    ∀ {p : ι → ℝ},
      (∀ (i : ι), 0 ≤ p i) →
        ∃ c,
          Function.Injective c ∧
            InformationTheory.IsPrefixFree (Set.range c) ∧
              (∀ (i : ι), (c i).length = ClassicalLean.InformationTheory.Huffman.huffmanLength p i) ∧
                ∀ (c' : ι → List α),
                  Function.Injective c' →
                    InformationTheory.IsPrefixFree (Set.range c') → ∑ i, p i * ↑(c i).length ≤ ∑ i, p i * ↑(c' i).length
@ClassicalLean.InformationTheory.Huffman.huffmanLength : {ι : Type u_1} →
  [DecidableEq ι] → [Fintype ι] → (ι → ℝ) → ι → ℕ
def ClassicalLean.InformationTheory.Huffman.huffmanLength.{u_1} : {ι : Type u_1} →
  [DecidableEq ι] → [Fintype ι] → (ι → ℝ) → ι → ℕ :=
fun {ι} [DecidableEq ι] [Fintype ι] p ↦ ClassicalLean.InformationTheory.Huffman.huffAux (Fintype.card ι) p Finset.univ
private def ClassicalLean.InformationTheory.Huffman.huffAux.{u_1} : {ι : Type u_1} →
  [DecidableEq ι] → ℕ → (ι → ℝ) → Finset ι → ι → ℕ :=
fun {ι} [DecidableEq ι] x x_1 x_2 ↦
  Nat.brecOn (motive := fun x ↦ (ι → ℝ) → Finset ι → ι → ℕ) x ClassicalLean.InformationTheory.Huffman.huffAux._f x_1 x_2
private def ClassicalLean.InformationTheory.Huffman.pick.{u_1} : {ι : Type u_1} →
  (ι → ℝ) → (s : Finset ι) → 2 ≤ #s → ι × ι :=
fun {ι} w s h ↦ Classical.choose ⋯
private def ClassicalLean.InformationTheory.Huffman.mergeLen.{u_1} : {ι : Type u_1} →
  [DecidableEq ι] → (ι → ℕ) → ι → ι → ι → ℕ :=
fun {ι} [DecidableEq ι] ℓ a b ↦ Function.update (Function.update ℓ a (ℓ a + 1)) b (ℓ a + 1)
private def ClassicalLean.InformationTheory.Huffman.mergeW.{u_1} : {ι : Type u_1} →
  [DecidableEq ι] → (ι → ℝ) → ι → ι → ι → ℝ :=
fun {ι} [DecidableEq ι] w a b ↦ Function.update w a (w a + w b)
